# ==============================================================================
# CodeSense — Backend & AI Configuration Environment Variables Template
# Copy this file to `backend/.env` and supply your actual configuration values.
# ==============================================================================

# ── LLM (Language Model) Configuration ───────────────────────────────────────
# Option A: Local Ollama (Default for offline/local development)
# LLM_API_TYPE=openai
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# MODEL=qwen2.5:3b
# CHAT_MODEL=qwen2.5:3b

# Option B: Google Gemini (Recommended for fast enterprise reviews)
LLM_API_TYPE=openai
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_gemini_api_key_here
MODEL=gemini-flash-lite-latest
CHAT_MODEL=gemini-flash-lite-latest

# Option C: OpenAI
# LLM_API_TYPE=openai
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=your_openai_api_key_here
# MODEL=gpt-4o-mini
# CHAT_MODEL=gpt-4o-mini

# ── Database (MongoDB) ────────────────────────────────────────────────────────
# Connection string for MongoDB (Local or Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/codesense?retryWrites=true&w=majority

# ── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_EMAIL=admin@codesense.dev

# ── Google OAuth 2.0 (Continue with Google) ──────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ── Email Service (Verification PIN / OTP Delivery) ──────────────────────────
# Leave blank for local development mode (PIN will be logged to server console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="CodeSense <no-reply@codesense.dev>"
EMAIL_SECURE=false

# ── Cashfree Payment Gateway (Subscriptions & Billing) ───────────────────────
# Leave blank to run in informational pricing / dev mode.
# Configure with test credentials from https://merchant.cashfree.com/merchants/login
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret_here
